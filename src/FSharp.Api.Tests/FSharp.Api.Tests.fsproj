<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="Scripts\CreateTables.sql">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="Scripts\ResetTables.sql">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Compile Include="Extensions.fs" />
        <Compile Include="OpenApiValidationHandler.fs" />
        <Compile Include="TestData.fs" />
        <Compile Include="TestEnv.fs" />
        <Compile Include="TestApp.fs" />
        <Compile Include="UserTests.fs" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Expecto" Version="11.1.1" />
      <PackageReference Include="Farse" Version="1.0.0" />
      <PackageReference Include="JsonSchema.Net" Version="9.6.0" />
      <PackageReference Include="Meziantou.Extensions.Logging.Xunit.v3" Version="3.0.11" />
      <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
      <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
      <PackageReference Include="xunit.v3" Version="4.0.2" />
      <PackageReference Update="FSharp.Core" Version="10.1.403" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\FSharp.Api\FSharp.Api.fsproj" />
    </ItemGroup>
</Project>